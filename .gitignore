# 成片与工程：每个人自己的产品，体积大（单个项目 1~4 GB），且工程里有 .env 密钥
outputs/*
!outputs/.gitkeep

# 密钥
.env
.env.*
!.env.example

# 依赖与生成物
node_modules/
template/out/
template/public/audio/*.wav
template/audio-src/_*
__pycache__/
*.py[cod]

# 系统与编辑器
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
*.swp
*.log

# 项目 Skill：从 GitHub 克隆的第三方 Skill，自带 LICENSE，需要时重新 clone
.claude/skills/anatomy/

# 项目白板 Skill：保留源码与 LICENSE，忽略本地环境和运行产物
.claude/skills/srt-whiteboard-animation/.venv/
.claude/skills/srt-whiteboard-animation/__pycache__/
.claude/skills/srt-whiteboard-animation/out/

# 外部视频项目源码（只当资料与代码来源，体积大，不进 git）
/vendor/

# 项目历史地图 Skill：跟踪上游源码，忽略运行环境和产物
.claude/skills/lifetrail/.venv/
.claude/skills/lifetrail/out/
.claude/skills/lifetrail/.cache/
.claude/skills/lifetrail/template/out/
.claude/skills/lifetrail/template/assets/terrain/
